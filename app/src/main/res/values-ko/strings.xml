    <string name="tab_quick_settings">빠른 설정</string>
    <string name="tab_shortcuts">단축키</string>
    <string name="tab_automation">자동화 연동</string>
    <string name="qs_desc">알림창 빠른 설정 패널에 다음 3가지 타일을 배치할 수 있습니다:</string>
    <string name="qs_tile1_title">① 무음 전환</string>
    <string name="qs_tile1_desc">무음 중과 소리 켬 2가지 아이콘이 상태에 따라 자동 전환</string>
    <string name="qs_tile2_title">② 카메라 무음</string>
    <string name="qs_tile2_desc">확실하게 무음을 직접 적용</string>
    <string name="qs_tile3_title">③ 카메라 소리 켬</string>
    <string name="qs_tile3_desc">확실하게 일반 소리로 복원</string>
    <string name="qs_a11y_notice_title">카메라 실행 중 홈 버튼 자동 탭 연동</string>
    <string name="qs_a11y_notice_desc">기본 카메라 실행 중 타일을 탭하면 무음 설정을 즉시 적용하기 위해 자동으로 홈 화면으로 이동합니다.</string>
    <string name="qs_edit_hint">※ 알림창을 두 번 아래로 쓸어내린 후 \'편집\'(연필 또는 점 3개 아이콘)에서 타일을 추가하세요.</string>
    <string name="shortcuts_desc">홈 화면의 \'Galax-Shh\' 아이콘을 길게 누르면 3가지 단축키가 팝업됩니다:</string>
    <string name="shortcuts_item1_desc">백그라운드에서 즉시 토글 전환</string>
    <string name="shortcuts_item2_desc">백그라운드에서 즉시 무음 적용</string>
    <string name="shortcuts_item3_desc">백그라운드에서 즉시 소리 활성화</string>
    <string name="shortcuts_drag_hint">※ 길게 누른 메뉴 항목을 홈 화면으로 드래그하면 독립된 무음 버튼 아이콘으로 배치할 수 있습니다. One UI \'모드 및 루틴\'의 바로가기 동작에서도 선택 가능합니다.</string>
    <string name="automation_intro">Tasker, MacroDroid, 모드 및 루틴 등의 자동화 앱에서 호출할 수 있습니다.</string>
    <string name="automation_tasker_title">● Tasker 플러그인 지원</string>
    <string name="automation_tasker_desc">Tasker의 \'작업 추가\' -> \'플러그인\' 목록에서 본 앱을 선택하고 ①무음 전환 ②카메라 무음 ③카메라 소리 켬 중 선택하여 설정할 수 있습니다.</string>
    <string name="automation_broadcast_title">● MacroDroid / 브로드캐스트 인텐트 전송 (탭하여 복사)</string>
    <string name="action_copy">복사</string>

    <!-- Accessibility Home Service Card -->
    <string name="a11y_card_title">홈 버튼 연동 (접근성)</string>
    <string name="a11y_status_running">활성 및 실행 중</string>
    <string name="a11y_status_waiting">연결 대기 중</string>
    <string name="a11y_status_disabled">비활성화됨</string>
    <string name="a11y_card_desc">기본 카메라 실행 중 퀵 설정 타일을 탭했을 때 설정 변경을 즉시 반영하기 위해 홈 화면으로 자동 이동합니다.</string>
    <string name="a11y_running_info">◎ 접근성 서비스가 활성화되어 있습니다. 카메라 실행 중 타일 조작 시 홈 버튼 누름이 자동으로 실행됩니다.</string>
    <string name="a11y_not_running_info">※ 활성화되지 않아도 인텐트 기반 홈 이동이 동작하지만, 접근성을 활성화하면 더 빠르고 확실하게 전환됩니다.</string>
    <string name="btn_open_a11y_settings">접근성 설정 열기</string>
    <string name="btn_check_a11y_settings">설정 확인</string>
    <string name="btn_test_home">홈 동작 테스트</string>

    <!-- Boot Auto Apply Card -->
