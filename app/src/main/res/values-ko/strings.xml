    <!-- EULA / Terms of Service Dialog -->
    <string name="eula_dialog_title">이용 시 유의사항 (반드시 읽어주세요)</string>
    <string name="eula_warning_badge">최초 확인사항</string>
    <string name="eula_intro">Galax-Shh는 촬영이 허가된 장소에서 주변을 배려하여 셔터 소리를 전환하는 유틸리티입니다. 이용 전 다음 사항을 확인하고 동의해 주십시오.</string>
    <string name="eula_section1_title">① 불법 촬영 및 도촬 행위 절대 금지</string>
    <string name="eula_section1_body">도촬 등 불법·유해 행위 사용을 엄격히 금지합니다. 관련 법령에 의해 엄중 처벌됩니다. 화장실, 탈의실, 목욕탕 등 프라이버시가 보호되어야 하는 장소에서 절대 사용하지 마십시오.</string>
    <string name="eula_section2_title">② 규칙 준수 및 본인 동의, 촬영 매너</string>
    <string name="eula_section2_body">소리가 나지 않는 것이 촬영 허가를 의미하지 않습니다. 법률 및 시설·주최자 규칙을 확인하고, 인물 촬영 시 필요에 따라 동의를 얻으십시오.</string>
    <string name="eula_section3_title">③ 동작 환경 및 자기 책임 (면책 조항)</string>
    <string name="eula_section3_body">기기 시스템 설정을 변경하여 동작하므로 OS나 지역에 따라 동작하지 않을 수 있습니다. 이용은 본인 책임이며 개발자는 책임을 지지 않습니다.</string>
    <string name="eula_checkbox_label">위의 이용 조건 및 금지사항을 모두 확인하였으며, 불법 행위 없이 책임과 매너를 지켜 사용할 것에 동의합니다</string>
    <string name="eula_btn_agree">동의하고 이용 시작하기</string>
    <string name="eula_btn_decline">동의하지 않음 (앱 종료)</string>
    <string name="toast_eula_required">이용약관 및 법령 준수 동의가 필요합니다. 앱을 열어 동의해주세요.</string>
    <string name="notification_eula_required_title">Galax-Shh: 이용약관 동의 필요</string>
    <string name="notification_eula_required_desc">카메라 무음 기능을 사용하려면 앱을 열어 이용약관에 동의해주세요.</string>
